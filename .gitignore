/.bundle/
/.yardoc
/_yardoc/
/coverage/
/doc/
/pkg/
/spec/reports/
/tmp/

# Gemfile.lock files are Ruby-version-sensitive (transitive deps can pin
# versions requiring a newer Ruby than some cells of the CI matrix), so each
# job resolves and caches its own instead of sharing a committed lock.
/Gemfile.lock
/example/gemfiles/*.gemfile.lock
